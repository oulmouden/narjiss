# api/.env — configuration locale de l'hotesse IA (NE PAS COMMITER).
# Copier ce fichier en « .env » et renseigner la cle OpenAI.

# Serveur LiveKit local (mutualise avec le projet Domiciliation).
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=twinburo-dev-secret-change-me-0123456789

# URL de base du site, utilisee par agent.py pour appeler les API PHP.
APP_URL=http://localhost/narjiss

# Cle OpenAI (STT Whisper + LLM gpt-4o-mini + TTS).
OPENAI_API_KEY=

# Notification de nouvelle fiche client (laisser vide pour désactiver).
FICHE_NOTIFY_TO=

# Envoi SMTP (laisser SMTP_HOST vide en dev : les e-mails vont dans data/mail-outbox/).
MAIL_FROM=no-reply@narjiss.company
MAIL_FROM_NAME=Narjiss Immobilière
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=
SMTP_PASS=
