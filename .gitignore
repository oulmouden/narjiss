# Dépendances / paquets installés
node_modules/
.tmp_qrcode_pkg/
__pycache__/
*.py[cod]
.venv/
venv/

# Archives et fichiers générés
*.zip
*.7z
*.log
*.tmp
*.bak

# Secrets / connexion base de donnees (ne JAMAIS versionner)
admin/includes/db-config.php
*.cnf

# Sauvegardes laissees par tools/reset-admin-password.php
admin/includes/config.php.bak-*

# Système
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Éditeurs / IDE
.vscode/
.idea/
*.swp

# Hôtesse IA — secrets et données locales (jamais versionnés)
api/.env
api/config.local.php
data/rendezvous.json

# Boîte d'envoi e-mail locale (données de prospects)
data/mail-outbox/

# Pièces d'identité réelles — JAMAIS versionnées (données personnelles sensibles)
CIN actionnaires/
cnie-test*
*.imported

# Originaux 360 avant optimisation (lourds, conservés en local seulement)
_orig-360/

# Secrets — visite guidée en direct (Pusher)
api/liveguide-config.php

# Sauvegardes d'optimisation d'images (copies locales)
_originaux/
*.bak-optim

# Exports 3DVista lourds (> 100 Mo, refusés par GitHub) — déployés séparément, hors dépôt
jawhara/Tour/Untitled 2_Windows.exe
jawhara/Tour/Untitled 2.tar.bz2
*.exe
*.tar.bz2

# Médias vidéo lourds — déployés via `deploy.sh videos`, hors dépôt git
data/videos/

# Sauvegardes opérationnelles (zones de plans, lots) — jamais versionnées
data/backups/
outputs/plan-zones/backups/
outputs/

# Dump de synchro prod généré (données, régénérable via tools/export-prod.php)
sql/prod-sync.sql

# Notes d'acces au serveur (URL phpMyAdmin, identifiants) — jamais versionnees
data/phpmyadmin-serveur.txt
data/*-serveur.txt
data/acces-*.txt

# Visionneuse 360 maison : arborescence de tuiles et configuration RÉGÉNÉRÉES
# depuis l'export 3DVista par tools/extract_3dvista_tour.js
# (voir GUIDE/tour-pannellum.md). Les versionner reviendrait à embarquer les
# tuiles d'un tour périmé dès le prochain ré-export.
# ⚠ Ne surtout pas élargir en **/pannellum/ : assets/vendor/pannellum/ est la
#   bibliothèque elle-même, et doit rester versionnée.
tour-pannellum.json
jawhara/*/pannellum/

# Visites 360 montées dans le back-office : photos et fichier publié,
# engendrés par les commerciaux — jamais du code.
visites/

# Raccourcis Windows (specifiques a une machine)
*.lnk
